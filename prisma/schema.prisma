// Memoria database schema
// See README.md section "Database Setup" for migration instructions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------
model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  image                 String?
  emailVerified         DateTime?
  passwordChangedAt     DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  notes                 Note[]
  reviewers             Reviewer[]
  quizzes               Quiz[]
  diagrams              Diagram[]
  quizAttempts          QuizAttempt[]
  sharesGiven           ResourceShare[]         @relation("SharesGivenByOwner")
  sharesGranted         ResourceShare[]         @relation("SharesGrantedToUser")
  publicLinksGiven      PublicResourceLink[]
  settings              UserSettings?
  collections           ShareCollection[]
  integrations          IntegrationConnection[]
  accountTokens         AccountToken[]
  flashcards            Flashcard[]
  flashcardProgress     FlashcardProgress[]
  flashcardReviews      FlashcardReview[]
  studySessions         StudySession[]
  tags                  Tag[]
  revisions             ResourceRevision[]
  notifications         Notification[]
  aiConnections         AiConnection[]
  invitesGiven          ResourceInvite[]        @relation("ResourceInvitesGiven")
  collectionMemberships ShareCollectionMember[]
  feedbackPosts         ShareFeedback[]         @relation("FeedbackAuthor")
  feedbackReports       FeedbackReport[]
  activeSessions        ActiveSession[]

  @@map("users")
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("account_tokens")
}

model IntegrationConnection {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  accessToken  Bytes
  refreshToken Bytes?
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("integration_connections")
}

enum IntegrationProvider {
  GOOGLE
  NOTION
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

model AiConnection {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  AiProvider
  apiKey    Bytes
  model     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("ai_connections")
}

model UserSettings {
  id                   String     @id @default(cuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  appearance           Appearance @default(SYSTEM)
  defaultQuestionCount Int        @default(10)
  defaultDifficulty    Difficulty @default(MIXED)
  defaultQuizMode      QuizMode   @default(QUIZ)
  showExplanations     Boolean    @default(true)
  autoSave             Boolean    @default(true)
  sidebarMode          String     @default("MANUAL")
  sidebarCollapsed     Boolean    @default(false)
  compactLayout        Boolean    @default(false)
  reduceMotion         Boolean    @default(false)
  updatedAt            DateTime   @updatedAt

  @@map("user_settings")
}

model ActiveSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, lastSeenAt])
  @@map("active_sessions")
}

enum Appearance {
  LIGHT
  DARK
  SYSTEM
}

// ---------------------------------------------------------------------------
// Notes
// ---------------------------------------------------------------------------
model Note {
  id               String         @id @default(cuid())
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  originalFilename String?
  sourceType       NoteSourceType
  sourceUrl        String?
  content          Bytes // gzip-compressed Markdown — see lib/compression.ts / lib/notes-repo.ts
  fileExtension    String?
  sourceExternalId String?
  sourceSyncedAt   DateTime?
  archivedAt       DateTime?
  isFavorite       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reviewerLinks ReviewerNote[]
  tags          NoteTag[]

  @@unique([ownerId, sourceType, sourceExternalId])
  @@index([ownerId, archivedAt, updatedAt])
  @@map("notes")
}

enum NoteSourceType {
  PDF
  MARKDOWN
  TXT
  DOCX
  GOOGLE_DOCS
  NOTION
  MANUAL
}

// ---------------------------------------------------------------------------
// Diagrams — embedded via :::diagram{id="..."} in MMD content (Note/Reviewer).
// See .context/diagram-system.md for the versioned `data` schema
// (lib/diagrams/schema.ts is the Zod source of truth) and for why diagrams
// are their own table rather than inline JSON inside Note/Reviewer content:
// independent editing, duplication, and reuse across documents.
// ---------------------------------------------------------------------------
model Diagram {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  data         Json // versioned MemoriaDiagram shape — see lib/diagrams/schema.ts
  schemaVersion Int     @default(1)
  // Rendered PNG/SVG snapshot for embedding in PDF/DOCX exports and for a
  // fast inline preview without re-rendering the live canvas — see
  // diagram-system.md "Export". Nullable: a brand-new diagram has no
  // snapshot until first saved from the editor.
  previewImage Bytes?
  previewMimeType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@map("diagrams")
}

// ---------------------------------------------------------------------------
// Reviewers
// ---------------------------------------------------------------------------
model Reviewer {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  style       ReviewerStyle @default(COMPLETE)
  content     Bytes // gzip-compressed Markdown — see lib/compression.ts / lib/reviewers-repo.ts
  archivedAt  DateTime?
  isFavorite  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  noteLinks  ReviewerNote[]
  quizLinks  QuizReviewer[]
  flashcards Flashcard[]
  tags       ReviewerTag[]

  @@index([ownerId, archivedAt, updatedAt])
  @@map("reviewers")
}

enum ReviewerStyle {
  COMPLETE
  QUICK
  EXAM
  CONCEPT
  DEFINITION
  COMPARISON
  CUSTOM
}

// Explicit join table so a reviewer can cite which source notes built it (noteIds).
model ReviewerNote {
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([reviewerId, noteId])
  @@map("reviewer_notes")
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------
model Quiz {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  mode          QuizMode  @default(QUIZ)
  configuration Json // question count, difficulty, distribution, randomization, timing, attempts
  questions     Json // validated array of Memoria quiz question objects
  archivedAt    DateTime?
  isFavorite    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviewerLinks QuizReviewer[]
  attempts      QuizAttempt[]
  tags          QuizTag[]

  @@index([ownerId, archivedAt, updatedAt])
  @@map("quizzes")
}

enum QuizMode {
  QUIZ
  PRACTICE_EXAM
  MOCK_EXAM
  TIMED_EXAM
  MASTERY_TEST
}

enum Difficulty {
  EASY
  NORMAL
  HARD
  MIXED
}

model QuizReviewer {
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@id([quizId, reviewerId])
  @@map("quiz_reviewers")
}

model QuizAttempt {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int           @default(0)
  totalQuestions Int
  answers        Json          @default("{}") // draft answers while active; graded answers after completion
  flagged        Json          @default("[]")
  questionOrder  Json          @default("[]")
  testMode       TestMode      @default(EXAM)
  status         AttemptStatus @default(IN_PROGRESS)
  deadline       DateTime?
  startedAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  @@index([userId, status, startedAt])
  @@index([quizId, userId, status])
  @@map("quiz_attempts")
}

enum TestMode {
  REVIEW
  EXAM
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Structured study / spaced repetition
// ---------------------------------------------------------------------------
model Flashcard {
  id         String              @id @default(cuid())
  ownerId    String
  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   Reviewer?           @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  front      String
  back       String
  sourceText String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  progress   FlashcardProgress[]
  reviews    FlashcardReview[]

  @@index([ownerId, updatedAt])
  @@index([reviewerId])
  @@map("flashcards")
}

model FlashcardProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  dueAt        DateTime  @default(now())
  intervalDays Float     @default(0)
  easeFactor   Float     @default(2.5)
  repetitions  Int       @default(0)
  lapses       Int       @default(0)
  lastGrade    Int?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
  @@map("flashcard_progress")
}

model FlashcardReview {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  grade       Int
  reviewedAt  DateTime  @default(now())

  @@index([userId, reviewedAt])
  @@index([flashcardId])
  @@map("flashcard_reviews")
}

model StudySession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewed    Int       @default(0)
  correct     Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ---------------------------------------------------------------------------
// Organization and revision history
// ---------------------------------------------------------------------------
model Tag {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime      @default(now())
  notes     NoteTag[]
  reviewers ReviewerTag[]
  quizzes   QuizTag[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model ReviewerTag {
  reviewerId String
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reviewerId, tagId])
  @@map("reviewer_tags")
}

model QuizTag {
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([quizId, tagId])
  @@map("quiz_tags")
}

model ResourceRevision {
  id           String       @id @default(cuid())
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resourceId   String
  resourceType ResourceType
  snapshot     Json
  createdAt    DateTime     @default(now())

  @@index([ownerId, resourceType, resourceId, createdAt])
  @@map("resource_revisions")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Sharing / permissions
// ---------------------------------------------------------------------------
enum ResourceType {
  NOTE
  REVIEWER
  QUIZ
  DIAGRAM
}

enum Permission {
  VIEW
  EDIT
  OWNER
}

// A single row per (resource, grantee). resourceId points at a Note, Reviewer, or
// Quiz id depending on resourceType. Prisma has no native polymorphic relation, so
// resourceId is a plain string and referential integrity for it is enforced in
// application code (see lib/permissions) rather than a DB-level foreign key.
// Cascade cleanup when a resource is deleted is handled explicitly in
// lib/permissions/index.ts (deleteSharesForResource), not by the database.
model ResourceShare {
  id           String       @id @default(cuid())
  resourceId   String
  resourceType ResourceType
  ownerId      String
  owner        User         @relation("SharesGivenByOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation("SharesGrantedToUser", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission   @default(VIEW)
  createdAt    DateTime     @default(now())

  @@unique([resourceId, resourceType, userId])
  @@index([userId])
  @@index([resourceId, resourceType])
  @@map("resource_shares")
}

model ResourceInvite {
  id           String       @id @default(cuid())
  resourceId   String
  resourceType ResourceType
  ownerId      String
  owner        User         @relation("ResourceInvitesGiven", fields: [ownerId], references: [id], onDelete: Cascade)
  email        String
  permission   Permission   @default(VIEW)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@unique([resourceId, resourceType, email])
  @@index([email, expiresAt])
  @@map("resource_invites")
}

// A revocable, unguessable link for viewing one resource without a Memoria
// account. Public pages remain read-only and verify that the link owner still
// owns the referenced resource before returning any content.
model PublicResourceLink {
  id           String       @id @default(cuid())
  resourceId   String
  resourceType ResourceType
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token        String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([resourceId, resourceType])
  @@index([ownerId])
  @@map("public_resource_links")
}

// ---------------------------------------------------------------------------
// Collections can be published at a public URL or privately shared with
// specific Memoria users.
// ---------------------------------------------------------------------------
model ShareCollection {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug         String    @unique
  title        String
  description  String?
  isPublished  Boolean   @default(false)
  passwordHash Bytes?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    ShareCollectionItem[]
  feedback ShareFeedback[]
  members  ShareCollectionMember[]

  @@index([ownerId])
  @@map("share_collections")
}

model ShareCollectionMember {
  id           String          @id @default(cuid())
  collectionId String
  collection   ShareCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())

  @@unique([collectionId, userId])
  @@index([userId, createdAt])
  @@map("share_collection_members")
}

// A resource (note/reviewer/quiz) included in a collection. resourceId is a
// plain string for the same polymorphic-relation reason as ResourceShare
// above — see lib/permissions/index.ts.
model ShareCollectionItem {
  id           String          @id @default(cuid())
  collectionId String
  collection   ShareCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceType ResourceType
  resourceId   String
  position     Int             @default(0)
  createdAt    DateTime        @default(now())

  @@unique([collectionId, resourceType, resourceId])
  @@index([collectionId])
  @@map("share_collection_items")
}

// Feedback left by anonymous visitors of a published collection. Optionally
// scoped to a single item within the collection (e.g. a comment on one
// specific note) or left general (resourceId null) for the collection as a whole.
model ShareFeedback {
  id           String           @id @default(cuid())
  collectionId String
  collection   ShareCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceType ResourceType?
  resourceId   String?
  authorName   String?
  authorUserId String?
  authorUser   User?            @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       ShareFeedback?   @relation("FeedbackThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ShareFeedback[]  @relation("FeedbackThread")
  message      String
  updatedAt    DateTime         @updatedAt
  createdAt    DateTime         @default(now())
  reports      FeedbackReport[]

  @@index([collectionId])
  @@index([parentId, createdAt])
  @@index([authorUserId])
  @@map("share_feedback")
}

model FeedbackReport {
  id         String        @id @default(cuid())
  feedbackId String
  feedback   ShareFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime      @default(now())

  @@unique([feedbackId, userId])
  @@index([userId, createdAt])
  @@map("feedback_reports")
}

// Durable fixed-window counters shared by every serverless instance.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
