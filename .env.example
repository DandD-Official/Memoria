# --- Database ---
# PostgreSQL connection string. Use a serverless-compatible provider
# (Neon, Supabase, Vercel Postgres, etc.) for Vercel deployments.
# Local example only — do not copy this localhost URL into Vercel.
# Production should use the provider's real pooled PostgreSQL connection URL.
DATABASE_URL="postgresql://user:password@localhost:5432/memoria?schema=public"

# --- Authentication (NextAuth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel):
# NEXTAUTH_URL="https://memoria-studynotes.vercel.app"

# --- User-owned integrations ---
# Google Cloud OAuth "Web application" client. GOOGLE_CLIENT_ID normally ends
# in .apps.googleusercontent.com. Do not put a callback URL in either value.
# Add these exact authorized redirect URIs in Google Cloud:
# http://localhost:3000/api/integrations/google/callback
# https://memoria-studynotes.vercel.app/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Create a public Notion integration. Copy its OAuth Client ID and Client Secret;
# neither value is a URL. Add these redirect URIs to the integration:
# http://localhost:3000/api/integrations/notion/callback
# https://memoria-studynotes.vercel.app/api/integrations/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Encrypts user OAuth access and refresh tokens at rest. Generate separately
# from AUTH_SECRET with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# --- System AI generation (available to every visitor) ---
# Configure one provider and one or more keys. Separate multiple keys with
# commas or new lines. Memoria tries them in order and uses the next key when
# a key fails. Keep these values server-only; never expose them to the browser.
# For AI/ML API, keep the provider protocol as OPENAI, set this base URL, and
# choose a model from https://docs.aimlapi.com/api-references/service-endpoints/complete-model-list.
AI_SYSTEM_PROVIDER="OPENAI"
AI_SYSTEM_BASE_URL=""
AI_SYSTEM_MODEL="gpt-4o-mini"
AI_SYSTEM_API_KEYS=""
# AI_SYSTEM_API_KEY="" # Optional singular-key alias for simple deployments.

# --- Transactional email (optional, enables verification/password reset) ---
# Create an API key at https://resend.com/api-keys
# Testing only (can send only to the email address on your Resend account):
# EMAIL_FROM="Memoria <onboarding@resend.dev>"
# Production: verify a domain you own in Resend, then use an address such as:
# EMAIL_FROM="Memoria <no-reply@your-domain.com>"
# The Vercel domain memoria-studynotes.vercel.app cannot be used as the sender
# domain because its DNS is owned by Vercel.
RESEND_API_KEY=""
EMAIL_FROM=""

# Protects the optional POST /api/maintenance/cleanup scheduled job.
CRON_SECRET=""

# --- File upload limits ---
# Max upload size in bytes for note imports (default 10MB)
MAX_UPLOAD_SIZE_BYTES="10485760"
